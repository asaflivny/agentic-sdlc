# Agentic SDLC Configuration
#
# For local development with direnv + pass:
#   1. brew install pass direnv gnupg (if not already installed)
#   2. pass init <your-gpg-key> (one-time setup)
#   3. pass insert asdlc/webhook_secret  # then paste your secret
#   4. direnv allow  # in this directory
#
# Secrets are stored in ~/.password-store/ and loaded via .envrc

# Core Configuration
OLLAMA_MODEL=qwen2.5-coder:14b
LOG_LEVEL=INFO
AGENT_TIMEOUT_SECONDS=600

# Webhook & API
WEBHOOK_SECRET=<stored in pass: asdlc/webhook_secret>
API_KEY=<optional; store in pass: asdlc/api_key>

# GitHub Integration (optional)
# GITHUB_TOKEN=ghp_<your-token>  # store in pass: asdlc/github_token
# GITHUB_REPO=owner/repo
# GITHUB_INLINE_COMMENTS=true

# Slack Integration (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/...  # store in pass: asdlc/slack_webhook
# SLACK_MENTION_CHANNELS=channel1,channel2

# Jenkins Integration (optional)
# JENKINS_DEFAULT_API_TOKEN=<token>  # store in pass: asdlc/jenkins_token

# Email Integration (optional)
# EMAIL_WEBHOOK_URL=https://...  # store in pass: asdlc/email_webhook
# EMAIL_RECIPIENTS=user@example.com,team@example.com

# Repository Configuration
REPOS_ROOT=./repos
GIT_CLONE_SOURCES=inventory-tracker:http://localhost:3000/admin/inventory-tracker.git

# Agent Configuration (optional)
# CODE_REVIEW_MODEL=qwen2.5-coder:32b
# SECURITY_MODEL=qwen2.5-coder:14b
# PERFORMANCE_MODEL=qwen2.5-coder:14b
# AGENT_USE_TOOLS=true
# AGENT_RECURSION_LIMIT=25

# Checkpointing (optional; default: true)
# ENABLE_CHECKPOINTING=true
# CHECKPOINT_DB_PATH=asdlc_checkpoints.db

# Structured Output Retry (optional; default: true)
# EXTRACTION_RETRY=true

# Diff Chunking (optional; default: 25)
# DIFF_CHUNK_SIZE_KB=25

# RAG Configuration (optional; default: true)
# RAG_ENABLED=true
# RAG_DB_PATH=./asdlc_rag.db
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_CHUNK_SIZE=500
# RAG_SIMILARITY_THRESHOLD=0.75
# RAG_SEARCH_LIMIT=5
